# ---------------------------------------------------
# MQTT BROKER CONFIG
# ---------------------------------------------------
# Mosquitto container port 1883 is mapped to host port 1884
# via docker-compose.
#
# Since the ingestor runs on the host, it must connect
# to localhost.

MQTT_BROKER=127.0.0.1
MQTT_PORT=1884

# Subscribe to all telemetry topics from the microgrid
MQTT_TOPIC=vn/telemetry/#


# ---------------------------------------------------
# POSTGRES / TIMESCALEDB CONFIG
# ---------------------------------------------------
# TimescaleDB container port 5432 is mapped to host 5432.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

POSTGRES_DB=voltanet
POSTGRES_USER=voltanet_user
POSTGRES_PASSWORD=voltanet_secret_2025